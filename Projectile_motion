import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# --- Parameters (change these!) ---
v0 = 25.0      # initial speed (m/s)
angle = 45     # launch angle (degrees)
g = 9.81       # gravity (m/s^2)
dt = 0.02      # time step (s)

# --- Physics: simulate step by step ---
vx = v0 * np.cos(np.radians(angle))
vy = v0 * np.sin(np.radians(angle))
x, y = 0.0, 0.0
xs, ys = [x], [y]

while y >= 0:
    vy -= g * dt          # gravity changes vertical velocity
    x += vx * dt
    y += vy * dt
    xs.append(x)
    ys.append(y)

# --- Animation ---
fig, ax = plt.subplots()
ax.set_xlim(0, max(xs) * 1.1)
ax.set_ylim(0, max(ys) * 1.2)
ax.set_xlabel("Distance (m)")
ax.set_ylabel("Height (m)")
ax.set_title("Projectile Motion")
ax.grid(True)

trail, = ax.plot([], [], "b-")
ball, = ax.plot([], [], "ro", markersize=10)

def update(i):
    trail.set_data(xs[:i], ys[:i])
    ball.set_data([xs[i]], [ys[i]])
    return trail, ball

anim = FuncAnimation(fig, update, frames=len(xs), interval=20, blit=True, repeat=False)
plt.show()
